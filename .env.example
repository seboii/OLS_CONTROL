# docker compose bu dosyayı okur. Kopyalayıp ".env" adıyla kaydedin.
# Tüm değerler yerel/geliştirme amaçlıdır — gerçek/üretim sırrı KOYMAYIN.
# .env dosyasının kendisi .gitignore'dadır, commit edilmez.

# --- Portlar (aynı makinedeki başka projelerle çakışmasın diye kaydırıldı) ---
FORWARD_DB_PORT=5443
FORWARD_SIBER_PORT=1444
API_PORT=8106
FRONTEND_PORT=8105

# --- Ağa açma (telefon / diğer bilgisayarlardan erişim) -----------------------
# Docker portları varsayılan olarak şöyle bağlanır:
#   frontend 8105 -> 0.0.0.0   (AĞA AÇIK — kullanıcılar buraya girer)
#   api      8106 -> 0.0.0.0   (ağa açık; sadece Swagger/curl için, şart değil)
#   postgres 5443 -> 127.0.0.1 (KAPALI)
#   mssql    1444 -> 127.0.0.1 (KAPALI)
# Uygulamanın kendisi TEK porttan çalışır: frontend'in nginx'i /api/ ve
# /storage/ isteklerini konteyner ağı üzerinden API'ye geçirir. Bu yüzden
# telefonun yalnızca 8105'e ulaşması yeterlidir.
#
# Erişim adresi: http://<bu-makinenin-LAN-IP'si>:8105
# LAN IP DHCP ile değişebilir; sabitlemek için modemden IP rezervasyonu yapın.
#
# Windows Güvenlik Duvarı 8105'e gelen bağlantıya izin vermelidir (Docker
# Desktop kendi kuralını kurar; çalışmazsa YÖNETİCİ PowerShell'de:
#   New-NetFirewallRule -DisplayName "OLS 8105" -Direction Inbound `
#     -Protocol TCP -LocalPort 8105 -Action Allow
# ).
#
# Aşağıdaki değişkenlerle bağlama adresini değiştirebilirsiniz:
FRONTEND_BIND_HOST=0.0.0.0
API_BIND_HOST=0.0.0.0
DB_BIND_HOST=127.0.0.1
SIBER_BIND_HOST=127.0.0.1
# Ağdan girildiğinde tarayıcı origin'i: http://<LAN-IP>:8105
# Aynı origin üzerinden çalışıldığı için CORS normalde devreye girmez; API'ye
# 8106'dan doğrudan istek atacaksanız burayı doldurun.
LAN_ORIGIN=

# --- PostgreSQL (yerel, docker içi) ---
DB_DATABASE=ols_scoped
DB_USERNAME=postgres
DB_PASSWORD=secret

# --- Sahte Siber (yerel MSSQL, CANLI Siber'e asla bağlanmaz) ---
SIBER_SA_PASSWORD=Ols!Local2026

# --- Gerçek Siber'e geçiş (BOŞ bırakın = sahte Siber kullanılır) ---
# Doldurduğunuzda docker-compose burayı ConnectionStrings:Siber olarak
# kullanır, sahte siber-mock'u DEĞİL. Bu satırı yalnızca kendi .env
# dosyanıza ekleyin — .env commit edilmediği için gerçek sunucu bilgileri
# asla repoya karışmaz. Sunucu bağlantısını SİZ açıp kapatıyorsunuz;
# asistan gerçek Siber'e kendisi bağlanmaz/bağlanamaz.
# Örnek: Server=192.168.1.101,1433;Database=Siber2022;User Id=sa;Password=***;TrustServerCertificate=True
SIBER_CONNECTION_OVERRIDE=

# --- Kullanıcı şifreleri ------------------------------------------------------
# Siber'den içe aktarılan kullanıcılar şifresiz gelir (Siber bcrypt hash
# taşımaz) ve giriş yapamazlar. Şifresi BOŞ olan her kullanıcıya bu şifre
# atanır; mevcut şifreler ezilmez.
SEED_DEFAULT_USER_PASSWORD=Admin123
# TEK SEFERLİK: true yapıp API'yi bir kez başlatırsanız MEVCUT şifreler DAHİL
# tüm kullanıcılar yukarıdaki şifreye döner. Sonra tekrar false yapın —
# aksi hâlde her açılışta herkesin şifresi sıfırlanır.
SEED_RESET_ALL_PASSWORDS=false

# --- JWT (yalnızca yerel geliştirme; üretimde User Secrets/ortam değişkeni kullanın) ---
JWT_KEY=yerel-test-anahtari-en-az-32-bayt-olmali-0000
JWT_ISSUER=ols-api
JWT_AUDIENCE=ols-app

ASPNETCORE_ENVIRONMENT=Development
