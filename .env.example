# docker compose bu dosyayı okur. Kopyalayıp ".env" adıyla kaydedin.
# Tüm değerler yerel/geliştirme amaçlıdır — gerçek/üretim sırrı KOYMAYIN.
# .env dosyasının kendisi .gitignore'dadır, commit edilmez.

# =============================================================================
# AĞ
#
# Ana yığında dışarıya AÇILAN TEK PORT web (nginx). API, PostgreSQL ve MSSQL
# hiç port yayınlamaz; birbirlerine Docker ağı üzerinden servis adlarıyla
# erişirler. Ayrıntı: infra/README.md
#
#   tarayıcı ──▶ web (8105) ──┬──▶ api:8080 ──┬──▶ postgres:5432
#                             │               └──▶ siber-mock:1433
#                             └── statik arayüz
# =============================================================================

WEB_PORT=8105

# 0.0.0.0 = ağa açık (telefon/diğer bilgisayar erişebilir).
# Cloudflare tüneli kullanınca 127.0.0.1 yapın: tünel Docker ağından bağlanır,
# yayınlanan port yalnızca yerel hata ayıklama için kalır.
WEB_BIND_HOST=0.0.0.0

# Erişim adresi: http://<bu-makinenin-LAN-IP'si>:8105
# LAN IP DHCP ile değişebilir; sabitlemek için modemden IP rezervasyonu yapın.
#
# Windows Güvenlik Duvarı 8105'e gelen bağlantıya izin vermelidir (Docker
# Desktop kendi kuralını kurar; çalışmazsa YÖNETİCİ PowerShell'de:
#   New-NetFirewallRule -DisplayName "OLS 8105" -Direction Inbound `
#     -Protocol TCP -LocalPort 8105 -Action Allow
# ).

# Yayın adresi (LAN IP ya da tünel alan adı). API'nin CORS izin listesine girer.
# Arayüz ve API aynı köken üzerinden çalıştığı için CORS normalde devreye
# girmez; bu değer API'ye DOĞRUDAN istek atan araçlar için.
# Örn: http://192.168.1.50:8105  ya da  https://ols.ornekalanadi.com
PUBLIC_ORIGIN=

# Cloudflare Zero Trust panelinden alınan tünel token'ı.
# infra/compose/cloudflared.yml ile birlikte kullanılır.
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# GELİŞTİRME PORTLARI
#
# Bunlar YALNIZCA infra/compose/dev.yml ile birlikte açılır:
#   docker compose -f docker-compose.yml -f infra/compose/dev.yml up -d
#
# Entegrasyon testleri localhost:5443'teki Postgres'e ihtiyaç duyar. Her
# komutta override yazmamak için aşağıdaki satırın yorumunu kaldırın:
#
#   COMPOSE_FILE=docker-compose.yml:infra/compose/dev.yml
# =============================================================================

FORWARD_DB_PORT=5443
FORWARD_SIBER_PORT=1444
API_PORT=8106

# Bu üçü bilerek 127.0.0.1: geliştiricinin kendi makinesi içindir.
DB_BIND_HOST=127.0.0.1
SIBER_BIND_HOST=127.0.0.1
API_BIND_HOST=127.0.0.1

# =============================================================================
# VERİTABANI
# =============================================================================

DB_DATABASE=ols_scoped
DB_USERNAME=postgres
DB_PASSWORD=secret

# =============================================================================
# SİBER
# =============================================================================

SIBER_SA_PASSWORD=Ols!Local2026

# BOŞ bırakılırsa yerel sahte Siber (siber-mock) kullanılır.
# Doldurulursa uygulama CANLI Siber veritabanına bağlanır — dikkatli olun.
# Örn: Server=192.168.1.101,1433;Database=Siber2022;User Id=sa;Password=***;TrustServerCertificate=True
SIBER_CONNECTION_OVERRIDE=

# =============================================================================
# UYGULAMA
# =============================================================================

# Siber'den gelen kullanıcıların şifresi yoktur; şifresi boş olan HERKESE bu
# şifre atanır. Mevcut şifreler ezilmez.
SEED_DEFAULT_USER_PASSWORD=Admin123

# TEK SEFERLİK bakım anahtarı: true iken MEVCUT şifreler dahil TÜM kullanıcılar
# yukarıdaki şifreye döndürülür. Her açılışta çalışır — kullandıktan sonra
# false yapın.
SEED_RESET_ALL_PASSWORDS=false

# TEK SEFERLİK: true iken açılışta Siber departmanlarına göre rol uygulanır ve
# Siber'de engelli kullanıcılar pasife alınır.
SEED_APPLY_ROLES=false

# Üretimde MUTLAKA değiştirin (en az 32 bayt).
JWT_KEY=yerel-test-anahtari-en-az-32-bayt-olmali-0000
JWT_ISSUER=ols-api
JWT_AUDIENCE=ols-app

ASPNETCORE_ENVIRONMENT=Development
